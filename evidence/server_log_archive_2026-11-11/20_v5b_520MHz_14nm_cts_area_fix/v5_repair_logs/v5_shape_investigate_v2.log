foreach pair [list [list M2 {{48.75 34.00} {49.30 34.20}}] [list M2 {{69.75 8.40} {70.80 8.67}}] [list M5 {{32.15 28.05} {32.26 28.10}}]] {
 set label [lindex $pair 0]
 set box [lindex $pair 1]
 puts "SHAPES_REGION=$label $box"
 set ss [get_shapes -hierarchical -include_fill -intersect $box]
 puts "SHAPE_COUNT=[sizeof_collection $ss]"
 set n 0
 foreach_in_collection s $ss {
  if {$n >= 25} {break}
  set parts {}
  foreach a {layer_name layer net_name net bbox shape_use shape_type width owner_type} {
   if {[catch {get_attribute $s $a} v]} {continue}
   lappend parts "$a=$v"
  }
  puts "SHAPE#$n [join $parts { | }]"
  incr n
 }
}
