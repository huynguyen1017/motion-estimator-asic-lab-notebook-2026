# ==============================================================================
# Targeted Fix for the Remaining 4 Cells Causing 9 ICV DRC Errors in v9_signoff
# Root causes found by geometry inspection:
#   1) pe_u/pe15/add_88/U_20 and pe_u/pe14/add_61/U_35 are SAEDRVT14_ADDH_0P5
#      (0.2 OD height, ZRT-044 invalid via region on CO) -> causes M2.S.2/M2.S.3
#   2) A1346 and A1699 are SAEDRVT14_OAI22_0P75 -> internal M1 pin geometry
#      causes M1.S.1 when abutting right neighbor without 1-site spacing
# ==============================================================================
set_host_options -max_cores 4
1
source -echo ./setup/fc_common_setup.tcl
#####################################################################
#####		Common Setup Script for Fusion Compiler		#####
#####################################################################
