# Over-constrain in2reg setup (+0.20 ns) and hold (+0.03 ns) during optimization
# so shared PE adder carry chains (add_61) have +0.20 ns setup slack at FUNC_Slow!
foreach scen [get_object_name [get_scenarios *]] {
    current_scenario $scen
    set_input_delay 0.70 -clock clock [get_ports {start R* S1* S2*}]
    set_input_delay -min 0.45 -clock clock [get_ports {start R* S1* S2*}]
    set_output_delay 0.55 -clock clock [get_ports {motionX* motionY* BestDist* completed}]
    set_clock_uncertainty -setup 0.25 [get_clocks clock]
    set_clock_uncertainty -hold 0.23 [get_clocks clock]
}
