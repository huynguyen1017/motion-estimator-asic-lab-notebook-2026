All analysis types are activated.
# Read Constraints for each scenario
set scenarios [get_attribute [get_scenarios ] name]
suppress_message UIC-034
foreach scenario ${scenarios} {
	current_scenario ${scenario}
	read_sdc ${SDC_FILE}
}
